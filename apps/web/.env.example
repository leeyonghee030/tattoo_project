# ---------------------------------------------------------------------------
# apps/web 환경 변수. 이 파일을 .env.local로 복사해서 쓴다.
# ---------------------------------------------------------------------------

# Spring 백엔드 주소. 서버 사이드에서만 쓰이므로 브라우저에 노출되지 않는다.
API_BASE_URL=http://localhost:8080

# 데이터 소스
#   mock — 목 저장소 사용. 백엔드 없이 모든 화면이 동작한다. (기본값)
#   http — Spring 호출. 해당 엔드포인트가 구현된 뒤에 켠다.
#          지금 구현된 건 로그인/로그아웃 4개뿐이므로, http로 켜면
#          대부분의 화면이 404(NOT_FOUND)를 받는다. 그게 의도된 동작이다.
DATA_SOURCE=mock

# 로그인도 목으로 처리 (1로 설정 시).
#   백엔드를 띄우지 않고 관리자·아티스트 화면만 확인할 때 쓴다.
#   아무 이메일/비밀번호로 로그인이 통과한다.
#   ⚠️ 발급되는 토큰은 서명이 유효하지 않아 실제 Spring API 호출에는 쓸 수 없다.
#   ⚠️ 운영 환경에서는 절대 켜지 말 것.
MOCK_AUTH=1
