<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.study.tattoo_project.mapper.TokenBlacklistMapper">
 <insert id="save" parameterType="com.study.tattoo_project.entity.TokenBlacklist">
         INSERT INTO token_blacklist_tb (token, expires_at)
         VALUES (#{token}, #{expiresAt})
    </insert>

    <select id="findByToken" parameterType="string" resultType="com.study.tattoo_project.entity.TokenBlacklist">
            SELECT * FROM token_blacklist_tb WHERE token = #{token}
    </select>

<!-- 만료시간지난거 삭제(자동으로 시간설정후 )
   &lt; "<" 아기호 xml에서 기호 사용 x-->
    <delete id="deleteExpired">
        DELETE FROM token_blacklist_tb WHERE expires_at &lt; NOW()
    </delete>



</mapper>

