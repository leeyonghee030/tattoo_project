# 저장소와 작업 복사본 모두 LF로 통일한다.
#
# 이 설정이 없으면 core.autocrlf=true 환경에서 텍스트 파일이 CRLF로 체크아웃된다.
# 그러면 db/*.sql · docs/ERD.md가 CRLF가 되는데 생성기(packages/contract)는 LF를 쓰므로
# `pnpm db:check`가 클론 직후부터 항상 실패한다.
* text=auto eol=lf

# Windows 배치 파일은 CRLF여야 실행된다.
*.bat text eol=crlf

# 셸 스크립트는 반드시 LF (위 규칙에 포함되지만 의도를 명시)
/gradlew text eol=lf

# 바이너리는 변환하지 않는다.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
